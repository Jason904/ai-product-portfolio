  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--font-mono, monospace);
  font-size: 10px;
  padding-bottom: 8px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.tc-sys-r1__wc-stage .meta-bar .left {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #fff;
}

.tc-sys-r1__wc-stage .meta-bar .left .dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--tc-sys-orange);
}

.tc-sys-r1__wc-stage .meta-bar .left .sub {
  color: #777;
  font-size: 9px;
}

.tc-sys-r1__wc-stage .meta-bar .right-badge {
  color: var(--tc-sys-orange);
  font-weight: 800;
}

.tc-sys-r1__wc-stage .viewport {
  width: 100%;
  border-radius: 6px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.5);
}

.tc-sys-r1__wc-stage .viewport img {
  width: 100%;
  height: auto;
  display: block;
}

.tc-sys-r1__wc-stage .caption-bar {
  display: flex;
  justify-content: space-between;
  font-family: var(--font-mono, monospace);
  font-size: 9.5px;
  color: #777;
  padding-top: 4px;
}
/* --------------------------------------------------------------------------
   03. ACT IV: 05.4 COMPOUND WORKFLOW MASTER (Near Black)
   -------------------------------------------------------------------------- */
.tc-sys-r1__master-row {
  display: grid;
  grid-template-columns: 28% 72%;
  gap: 32px;
  align-items: start;
  padding: 48px 0 24px;
}

.tc-sys-r1__recompose-rail {
  margin-top: 20px;
  padding: 12px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px dashed rgba(255, 255, 255, 0.12);
  border-radius: 6px;
  font-family: var(--font-mono, monospace);
  font-size: 10px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  color: #aaa;
}

.tc-sys-r1__recompose-rail .hi {
  color: var(--tc-sys-orange);
  font-weight: 800;
}

.tc-sys-r1__master-axes {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 8px;
  margin-bottom: 12px;
  text-align: center;
  font-family: var(--font-mono, monospace);
}

.tc-sys-r1__master-axis-item .en {
  font-size: 10px;
  font-weight: 800;
  color: #fff;
  display: block;
}

.tc-sys-r1__master-axis-item .cn {
  font-size: 9px;
  color: var(--tc-sys-orange);
}

.tc-sys-r1__master-canvas-frame {
  width: 100%;
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid var(--tc-sys-dark-border);
  box-shadow: 0 16px 48px rgba(0, 0, 0, 0.9);
  background: #000;
}

.tc-sys-r1__master-canvas-frame img {
  width: 100%;
  height: auto;
  display: block;
}

.tc-sys-r1__master-bottom-thesis {
  text-align: right;
  margin-top: 28px;
  padding-top: 20px;
  border-top: 1px solid var(--tc-sys-dark-border);
}

.tc-sys-r1__master-bottom-thesis .cn {
  font-size: 20px;
  font-weight: 800;
  color: #fff;
  margin: 0 0 6px;
}

.tc-sys-r1__master-bottom-thesis .en {
  font-family: var(--font-mono, monospace);
  font-size: 11px;
  font-weight: 800;
  color: var(--tc-sys-orange);
  letter-spacing: 0.08em;
}

/* --------------------------------------------------------------------------
   04. ACT V: 05 CLOSING 3-COLUMN CONSOLE & BRAND FOOTER (Warm Paper)
   -------------------------------------------------------------------------- */
.tc-sys-r1__closing-grid {
  display: grid;
  grid-template-columns: 32% 42% 26%;
  gap: 36px;
  align-items: center;
  padding: 64px 0 48px;
}

.tc-sys-r1__six-dims-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
  font-family: var(--font-mono, monospace);
  font-size: 9.5px;
}

.tc-sys-r1__six-dims-row span {
  padding: 3px 6px;
  background: rgba(23, 23, 20, 0.04);
  border: 1px solid var(--tc-sys-hairline);
  border-radius: 3px;
  color: var(--tc-sys-ink);
  font-weight: 700;
}

.tc-sys-r1__closing-quote {
  font-size: 17px;
  font-weight: 800;
  line-height: 1.4;
  color: var(--tc-sys-ink);
  margin: 0 0 8px;
}

.tc-sys-r1__closing-next-box {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding-left: 20px;
  border-left: 1px solid var(--tc-sys-hairline);
}

.tc-sys-r1__closing-next-kicker {
  font-family: var(--font-mono, monospace);
  font-size: 10px;
  color: var(--tc-sys-ink-light);
  letter-spacing: 0.08em;
}

.tc-sys-r1__closing-next-link {
  font-size: 18px;
  font-weight: 800;
  color: var(--tc-sys-ink);
  text-decoration: none;
  border-bottom: 2px solid var(--tc-sys-orange);
  width: fit-content;
  padding-bottom: 2px;
}

/* Brand Footer Bar */
.tc-sys-r1__brand-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 0;
  border-top: 1px solid var(--tc-sys-hairline);
  font-family: var(--font-mono, monospace);
  font-size: 10px;
  color: var(--tc-sys-ink-light);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.tc-sys-r1__brand-footer .left {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--tc-sys-ink-muted);
  font-weight: 700;
}

/* --------------------------------------------------------------------------
   RESPONSIVE
   -------------------------------------------------------------------------- */
@media (max-width: 1080px) {
  .tc-sys-r1__opening-grid,
  .tc-sys-r1__unified-state-grid,
  .tc-sys-r1__tri-band,
  .tc-sys-r1__sec03-head,
  .tc-sys-r1__camera-dock,
  .tc-sys-r1__gap-header,
  .tc-sys-r1__gap-stage,
  .tc-sys-r1__timelapse-header,
  .tc-sys-r1__timelapse-stepper,
  .tc-sys-r1__timelapse-foot,
  .tc-sys-r1__continuity-master-row,
  .tc-sys-r1__master-row,
  .tc-sys-r1__closing-grid {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .tc-sys-r1__plan-layout {
    grid-template-columns: 1fr;
  }

  .tc-sys-r1__camera-dock-rail {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .tc-sys-r1__camera-dock-rail .rail-arrow {
    display: none;
  }
}
